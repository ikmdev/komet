<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.shape.SVGPath?>

<?import javafx.scene.control.SeparatorMenuItem?>
<BorderPane fx:id="journalRootPane" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="dev.ikm.komet.kview.mvvm.view.journal.JournalController">
   <center>
      <BorderPane prefHeight="485.0" prefWidth="544.0" BorderPane.alignment="CENTER">
         <top>
            <HBox fx:id="projectBarHBox" prefHeight="100.0" prefWidth="200.0" styleClass="project-bar" BorderPane.alignment="CENTER">
               <children>
                  <MenuButton fx:id="coordinatesMenuButton" contentDisplay="GRAPHIC_ONLY" styleClass="coordinate">
                     <items>
                        <Menu fx:id="windowCoordinates" mnemonicParsing="false" text="Coordinates" />
                     </items>
                     <tooltip><Tooltip text="Coordinates" /></tooltip>
                  </MenuButton>
                  <Button fx:id="addButton" mnemonicParsing="false" onAction="#popupAddContextMenu" text="Button">
                     <graphic>
                        <Region focusTraversable="true">
                           <styleClass>
                              <String fx:value="plus-symbol" />
                              <String fx:value="icon" />
                           </styleClass>
                        </Region>
                     </graphic>
                     <tooltip><Tooltip text="Create" /></tooltip>
                     <contextMenu>
                        <!-- Styled like the field-level context menus (e.g. Edit Text / Remove): klcontext-menu
                             box + 12px icon-klcontext-menu graphics. -->
                        <ContextMenu fx:id="addContextMenu" opacity="0.99" styleClass="klcontext-menu">
                          <items>
                            <MenuItem mnemonicParsing="false" onAction="#newCreateConcept2Window" text="New Concept">
                                 <graphic>
                                    <Region>
                                       <styleClass>
                                          <String fx:value="add-notepad" />
                                          <String fx:value="icon-klcontext-menu" />
                                       </styleClass>
                                    </Region>
                                 </graphic>
                            </MenuItem>
                            <MenuItem mnemonicParsing="false" onAction="#newCreatePattern2Window" text="New Pattern">
                                <graphic>
                                   <Region>
                                      <styleClass>
                                         <String fx:value="add-chapter" />
                                         <String fx:value="icon-klcontext-menu" />
                                      </styleClass>
                                   </Region>
                                </graphic>
                            </MenuItem>
                              <SeparatorMenuItem fx:id="addContextMenuSeparator" visible="false"/>
                              <!-- Legacy windows: superseded by the KL-editor-driven windows above; slated for removal.
                                   The controller inserts the dynamic (editor/tool/card) entries before this separator. -->
                              <SeparatorMenuItem fx:id="legacySeparator"/>
                            <MenuItem mnemonicParsing="false" onAction="#newCreateConceptWindow" text="New Concept (legacy)" styleClass="legacy-menu-item">
                                 <graphic>
                                    <Region>
                                       <styleClass>
                                          <String fx:value="add-notepad" />
                                          <String fx:value="icon-klcontext-menu" />
                                       </styleClass>
                                    </Region>
                                 </graphic>
                            </MenuItem>
                            <MenuItem mnemonicParsing="false" onAction="#newCreatePatternWindow" text="New Pattern (legacy)" styleClass="legacy-menu-item">
                                <graphic>
                                   <Region>
                                      <styleClass>
                                         <String fx:value="add-chapter" />
                                         <String fx:value="icon-klcontext-menu" />
                                      </styleClass>
                                   </Region>
                                </graphic>
                            </MenuItem>
                            <MenuItem mnemonicParsing="false" onAction="#newCreateLidrWindow" text="New LIDR Record (legacy)" styleClass="legacy-menu-item">
                                 <graphic>
                                    <Region>
                                       <styleClass>
                                          <String fx:value="add-chapter" />
                                          <String fx:value="icon-klcontext-menu" />
                                       </styleClass>
                                    </Region>
                                 </graphic>
                            </MenuItem>
                          </items>
                        </ContextMenu>
                     </contextMenu>
                  </Button>
                  <Rectangle fill="DODGERBLUE" height="32.0" stroke="BLACK" strokeType="INSIDE" styleClass="vertical-divider" width="1.0" />
                  <ComboBox fx:id="journalComboBox" prefWidth="200.0" promptText="Journal name" styleClass="combo-box-drop">
                     <opaqueInsets>
                        <Insets />
                     </opaqueInsets>
                  </ComboBox>
                  <Rectangle fill="DODGERBLUE" height="32.0" stroke="BLACK" strokeType="INSIDE" styleClass="vertical-divider" width="1.0" />
                  <Button mnemonicParsing="false" text="Button">
                     <graphic>
                        <Region prefHeight="200.0" prefWidth="200.0">
                           <styleClass>
                              <String fx:value="notepad-symbol" />
                              <String fx:value="icon" />
                           </styleClass>
                        </Region>
                     </graphic>
                     <tooltip><Tooltip text="Journal Notes" /></tooltip>
                  </Button>
                  <Button mnemonicParsing="false" text="Button">
                     <graphic>
                        <Region prefHeight="200.0" prefWidth="200.0">
                           <styleClass>
                              <String fx:value="icon" />
                              <String fx:value="comment" />
                           </styleClass>
                        </Region>
                     </graphic>
                     <tooltip><Tooltip text="Journal Comments" /></tooltip>
                  </Button>
               </children>
            </HBox>
         </top>
         <center>
            <BorderPane BorderPane.alignment="CENTER">
               <center>
                  <BorderPane prefHeight="200.0" prefWidth="200.0">
                     <center>
                        <KLWorkspace fx:id="workspace" focusTraversable="true" />
                     </center>
                  </BorderPane>
               </center>
            </BorderPane>
         </center>
         <left>
            <StackPane fx:id="trayPaneContainer" BorderPane.alignment="CENTER" />
         </left>
      </BorderPane>
   </center>
   <left>
      <VBox fx:id="sidebarVBox" maxHeight="1.7976931348623157E308" maxWidth="-Infinity" minWidth="-Infinity" styleClass="side-bar" BorderPane.alignment="CENTER">
         <children>
            <Button mnemonicParsing="false" styleClass="home-button" text="Button">
               <graphic>
                  <Region>
                     <styleClass>
                        <String fx:value="icon" />
                        <String fx:value="home" />
                     </styleClass>
                  </Region>
               </graphic>
               <tooltip><Tooltip text="Home" /></tooltip>
            </Button>
            <Rectangle fill="DODGERBLUE" height="1.0" stroke="BLACK" strokeType="INSIDE" styleClass="divider" width="36.0" />
            <ToggleButton fx:id="nextGenSearchToggleButton" mnemonicParsing="false" text="ToggleButton">
               <graphic>
                  <Region prefHeight="200.0" prefWidth="200.0">
                     <styleClass>
                        <String fx:value="icon" />
                        <String fx:value="search" />
                     </styleClass>
                  </Region>
               </graphic>
               <toggleGroup>
                  <ToggleGroup fx:id="sidebarToggleGroup" />
               </toggleGroup>
               <tooltip><Tooltip text="Nextgen Search" /></tooltip>
            </ToggleButton>
            <ToggleButton fx:id="navigatorToggleButton" mnemonicParsing="false" text="ToggleButton" toggleGroup="$sidebarToggleGroup">
               <graphic>
                  <Region prefHeight="200.0" prefWidth="200.0">
                     <styleClass>
                        <String fx:value="icon" />
                        <String fx:value="navigator" />
                     </styleClass>
                  </Region>
               </graphic>
               <tooltip><Tooltip text="Nextgen Navigator" /></tooltip>
            </ToggleButton>
            <ToggleButton fx:id="reasonerToggleButton" mnemonicParsing="false" styleClass="reasoner" text="ToggleButton" toggleGroup="$sidebarToggleGroup">
               <graphic>
                  <Region prefHeight="200.0" prefWidth="200.0">
                     <styleClass>
                        <String fx:value="icon" />
                        <String fx:value="reasoner-icon" />
                     </styleClass>
                  </Region>
               </graphic>
               <tooltip><Tooltip text="Reasoner" /></tooltip>
            </ToggleButton>
            <Rectangle fill="DODGERBLUE" height="1.0" stroke="BLACK" strokeType="INSIDE" styleClass="divider" width="36.0" />
            <ToggleButton fx:id="searchToggleButton" mnemonicParsing="false" text="ToggleButton" toggleGroup="$sidebarToggleGroup">
               <graphic>
                  <Region prefHeight="200.0" prefWidth="200.0">
                     <styleClass>
                        <String fx:value="icon" />
                        <String fx:value="heart" />
                     </styleClass>
                  </Region>
               </graphic>
               <tooltip><Tooltip text="Search" /></tooltip>
            </ToggleButton>
            <Rectangle fill="DODGERBLUE" height="1.0" stroke="BLACK" strokeType="INSIDE" styleClass="divider" width="36.0" />
            <ToggleButton fx:id="conceptNavigatorToggleButton" mnemonicParsing="false" text="ToggleButton" toggleGroup="$sidebarToggleGroup">
               <graphic>
                  <Region prefHeight="200.0" prefWidth="200.0">
                     <styleClass>
                        <String fx:value="icon" />
                        <String fx:value="comment" />
                     </styleClass>
                  </Region>
               </graphic>
               <tooltip><Tooltip text="Navigator" /></tooltip>
            </ToggleButton>
            <ToggleButton fx:id="nextGenReasonerToggleButton" mnemonicParsing="false" text="ToggleButton" toggleGroup="$sidebarToggleGroup">
               <graphic>
                  <Region prefHeight="200.0" prefWidth="200.0">
                     <styleClass>
                        <String fx:value="icon" />
                        <String fx:value="notification" />
                     </styleClass>
                  </Region>
               </graphic>
               <tooltip><Tooltip text="NextGen Reasoner" /></tooltip>
            </ToggleButton>
            <Region styleClass="flex-space" VBox.vgrow="ALWAYS" />
            <ToggleButton fx:id="progressToggleButton" mnemonicParsing="false" text="ToggleButton" toggleGroup="$sidebarToggleGroup">
               <graphic>
                  <StackPane>
                     <children>
                        <Group>
                           <children>
                              <Circle fill="#ff215c0a" radius="13.0" stroke="#ffffff1a" strokeType="INSIDE" strokeWidth="7.0" />
                              <Arc fill="#c4ff2100" length="270.0" radiusX="13.0" radiusY="13.0" startAngle="180.0" stroke="#00bc62" strokeLineCap="BUTT" strokeType="INSIDE" strokeWidth="7.0" />
                           </children>
                        </Group>
                     </children>
                  </StackPane>
               </graphic>
            </ToggleButton>
            <ToggleButton fx:id="settingsToggleButton" mnemonicParsing="false" onAction="#openSettings" text="ToggleButton">
               <graphic>
                  <Region prefHeight="200.0" prefWidth="200.0">
                     <styleClass>
                        <String fx:value="icon" />
                        <String fx:value="settings" />
                     </styleClass>
                  </Region>
               </graphic>
               <tooltip><Tooltip text="Settings" /></tooltip>
            </ToggleButton>
            <ToggleButton mnemonicParsing="false" text="ToggleButton" toggleGroup="$sidebarToggleGroup">
               <graphic>
                  <Region prefHeight="200.0" prefWidth="200.0">
                     <styleClass>
                        <String fx:value="icon" />
                        <String fx:value="avatar" />
                     </styleClass>
                  </Region>
               </graphic>
               <tooltip><Tooltip text="Profile" /></tooltip>
            </ToggleButton>
         </children>
      </VBox>
   </left>
</BorderPane>
